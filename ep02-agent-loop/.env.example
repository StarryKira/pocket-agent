# 复制成 .env 再填 key：cp .env.example .env（Windows：copy .env.example .env）
# .env 已经写进 .gitignore，不会被提交。

# ---- 用 DeepSeek（视频里用的）----
# 照 DeepSeek 官方 Claude Code 接入指南填写；模型名以指南最新版为准：
# https://api-docs.deepseek.com/zh-cn/quick_start/agent_integrations/claude_code
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=在这里填你的 DeepSeek API key
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# ---- 用 Claude 官方 API ----
# 删掉上面 DeepSeek 那一段，只留下面这一行（去掉开头的 #）：
# ANTHROPIC_API_KEY=在这里填你的 Claude API key
